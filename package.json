{
  "name": "project-iris",
  "version": "1.23.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.13",
    "lightweight-charts": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.9.4",
    "swagger-ui-react": "^5.33.1"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "check:versions": "node scripts/check-version.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:e2e": "vite build --mode e2e",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:e2e": "npm run build:e2e && playwright test",
    "build:vertical": "vite build --mode vertical",
    "preview:vertical": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:vertical": "npm run build:vertical && playwright test --config=playwright.vertical.config.ts"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "jsdom": "^26.1.0",
    "prettier": "^3.2.5",
    "prettier-eslint": "^16.3.0",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.3.6",
    "vitest": "^3.2.4"
  }
}
